#24=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#23,$);
#30=IFCPROJECT('3DemoProj0000000000001',$,'Instalatii Demo',$,$,$,$,(#24),#12);
#31=IFCLOCALPLACEMENT($,#23);
#36=IFCBUILDINGSTOREY('3DemoLvl00000000000001',$,'Parter',$,$,#31,$,$,.ELEMENT.,0.);
#37=IFCRELAGGREGATES('3DemoRel0000000000001',$,$,$,#30,(#36));
/* conducta de ventilatie 400x300 care traverseaza grinda (clash) */
#100=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,400.,300.);
#101=IFCCARTESIANPOINT((5000.,0.,2650.));
#102=IFCDIRECTION((0.,1.,0.));
#103=IFCAXIS2PLACEMENT3D(#101,#102,#22);
#104=IFCEXTRUDEDAREASOLID(#100,#103,#21,8000.);
#105=IFCSHAPEREPRESENTATION(#24,'Body','SweptSolid',(#104));
