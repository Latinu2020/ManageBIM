#107=IFCLOCALPLACEMENT(#31,#23);
#108=IFCDUCTSEGMENT('3DemoDuct000000000001',$,'Tubulatura VE-01',$,$,#107,#106,$,.RIGIDSEGMENT.);
/* teava - swept disk, la 120mm de stalp (clearance) */
#200=IFCCARTESIANPOINT((3820.,0.,1500.));
#201=IFCCARTESIANPOINT((3820.,8000.,1500.));
#202=IFCPOLYLINE((#200,#201));
#203=IFCSWEPTDISKSOLID(#202,40.,$,$,$);
#204=IFCSHAPEREPRESENTATION(#24,'Body','AdvancedSweptSolid',(#203));
#205=IFCPRODUCTDEFINITIONSHAPE($,$,(#204));
#206=IFCLOCALPLACEMENT(#31,#23);
#207=IFCPIPESEGMENT('3DemoPipe000000000001',$,'Teava apa rece DN80',$,$,#206,#205,$,.RIGIDSEGMENT.);
/* corp iluminat - triangulated face set */
#300=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(600.,0.,0.),(600.,600.,0.),(0.,600.,0.),(300.,300.,-100.)));
#301=IFCTRIANGULATEDFACESET(#300,$,.T.,((1,3,2),(1,4,3),(1,2,5),(2,3,5),(3,4,5),(4,1,5)),$);
#302=IFCSHAPEREPRESENTATION(#24,'Body','Tessellation',(#301));
#303=IFCPRODUCTDEFINITIONSHAPE($,$,(#302));
#304=IFCCARTESIANPOINT((1500.,1500.,2790.));
#305=IFCAXIS2PLACEMENT3D(#304,$,$);
#306=IFCLOCALPLACEMENT(#31,#305);
#307=IFCLIGHTFIXTURE('3DemoLgt0000000000001',$,'Corp iluminat L1',$,$,#306,#303,$,.POINTSOURCE.);
#400=IFCPROPERTYSINGLEVALUE('Sistem',$,IFCLABEL('Ventilatie VE'),$);
#401=IFCPROPERTYSET('3DemoPset000000000001',$,'Date_Instalatii',$,(#400));
#402=IFCRELDEFINESBYPROPERTIES('3DemoRdp0000000000001',$,$,$,(#108),#401);
#500=IFCRELCONTAINEDINSPATIALSTRUCTURE('3DemoCnt0000000000001',$,$,$,(#108,#207,#307),#36);
