DATA;
#4=IFCAPPLICATION($,'1.0','BimRust Demo Generator','BIMR');
#10=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCUNITASSIGNMENT((#10));
#20=IFCCARTESIANPOINT((0.,0.,0.));
#21=IFCDIRECTION((0.,0.,1.));
#22=IFCDIRECTION((1.,0.,0.));
